# Example environment file — copy this to .env and fill in real values
# The .env file itself is gitignored and should NEVER be committed

# MongoDB Atlas connection URI — get from MongoDB Atlas > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# Hadoop home directory on your machine (Windows: use forward slashes)
HADOOP_HOME=C:/hadoop
